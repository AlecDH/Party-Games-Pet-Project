@startuml
!pragma layout smetana
'https://plantuml.com/sequence-diagram

object Bruger{
brugernavn
adgangskode
favoritter : liste
reviews : liste
}

object Spil{
spillere : int
materialer : liste
}

object Review{
forfatter
rating : int
tekst
}

object Forum

object Ruleset

object Gameplay

Bruger "1..*" --- "0..*" Spil : Gør til favorit
Review "0..*" --- "1" Spil : Tilhører
Bruger "1" --- "0..*" Review : Opretter
Forum "0..*" --- "0..*" Bruger
Spil "1" --- "1..*" Ruleset
Spil "1" --- "1" Gameplay

@enduml